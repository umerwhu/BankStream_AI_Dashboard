# BANKSTREAM DASHBOARD CONFIGURATION
# 1. Copy this file to .env in this folder.
# 2. Demo mode runs without TapData or database credentials.
# 3. Replace a placeholder only when enabling that integration.
# 4. Never commit .env or put real secrets in this example file.

# Application
# Bind to 0.0.0.0 for LAN access, or 127.0.0.1 for localhost only (default).
HOST=127.0.0.1
# HTTP port (integer 1-65535). Required. Default in code: 3001.
PORT=3001
# development enables demo roles; production requires a trusted identity proxy.
# Optional. Default: development.
NODE_ENV=development
# Local JSON persistence folder. Optional. Default: ./var.
STATE_DIR=./var
# Banking data source: demo, tapdata, mongodb, or api. Optional; demo is safest.
DATA_SOURCE=demo

# AI provider (deepseek or openai). Optional. Default: deepseek.
AI_PROVIDER=deepseek
# Model identifier. Optional. Default: deepseek-chat (DeepSeek) / gpt-4o-mini (OpenAI).
AI_MODEL=deepseek-chat
# Chat-completions API root. Optional. Default: provider-specific URL below.
AI_BASE_URL=https://api.deepseek.com
# Required only for live DeepSeek features. Replace with your own secret; never commit it.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
# Required only when AI_PROVIDER=openai. Keep your real key in .env only.
OPENAI_API_KEY=replace-with-your-openai-api-key

# TapData published API (used only when DATA_SOURCE=tapdata)
# Required for TapData mode. Example host only; replace with your deployment URL.
TAPDATA_API_BASE_URL=https://tapdata.example.invalid
# Find endpoint; {collection} is replaced with the published API name.
# Required for TapData mode. No code default.
TAPDATA_FIND_PATH_TEMPLATE=/api/v1/{collection}
# JSON source-table to published-service mapping. Unlisted tables use their own names.
# Optional. Default: empty map. CUSTOMER mapping below is an example.
TAPDATA_COLLECTION_MAP={"CUSTOMER":"MDM_CUSTOMER360"}
# HTTP verb for the TapData find API. Optional. Default: POST.
TAPDATA_FIND_METHOD=GET
# Filter style: query or body. Optional. Default: body.
TAPDATA_FIND_REQUEST_STYLE=query
# Additional JSON filter object. Optional. Default: {}.
TAPDATA_FIND_FILTER={}
# Records requested per page. Optional. Default: 200.
TAPDATA_PAGE_SIZE=200
# Maximum records scanned from each published table. Optional. Default: 1000.
TAPDATA_SCAN_LIMIT=1000
# Server-side data cache lifetime in milliseconds. Optional. Default: 10000.
TAPDATA_CACHE_TTL_MS=10000
# TapData request timeout in milliseconds (minimum 250). Optional. Default: 15000.
TAPDATA_REQUEST_TIMEOUT_MS=15000
# OAuth token endpoint. Optional if using a fixed bearer token. No default.
TAPDATA_TOKEN_URL=https://tapdata.example.invalid/oauth/token
# OAuth client ID. Required with the OAuth client secret. Dummy value only.
TAPDATA_CLIENT_ID=replace-with-client-id
# OAuth client secret. Required with the OAuth client ID; keep actual secret in .env.
TAPDATA_CLIENT_SECRET=replace-with-client-secret
# client_secret_post or client_secret_basic. Optional. Default: client_secret_post.
TAPDATA_TOKEN_AUTH_METHOD=client_secret_post
# Fixed bearer token for local testing only. Optional. Prefer OAuth. Default: empty.
TAPDATA_ACCESS_TOKEN=replace-with-access-token-if-needed

# MongoDB source (used only when DATA_SOURCE=mongodb; optional driver is not bundled)
# Connection URI and credentials. No default; use BANKING_MONGODB_URI or MONGODB_URI.
BANKING_MONGODB_URI=mongodb://example:example@mongodb.example.invalid:27017/banking
# Database name. Optional; default comes from the URI.
BANKING_MONGODB_DATABASE=banking
# JSON source-table to collection-name map. Required for mapped Mongo collections.
BANKING_MONGODB_COLLECTION_MAP={}
# Legacy aliases. Used only if corresponding BANKING_MONGODB_* value is empty.
MONGODB_URI=mongodb://example:example@mongodb.example.invalid:27017/banking
# Legacy database-name alias; used if BANKING_MONGODB_DATABASE is empty.
MONGODB_DATABASE=banking
# Legacy collection-map alias; used if BANKING_MONGODB_COLLECTION_MAP is empty.
MONGODB_COLLECTION_MAP={}
# Maximum documents read per collection. Optional. Default: 500.
MONGODB_READ_LIMIT=500

# Legacy single-bundle API (used only when DATA_SOURCE=api)
# API base URL. Optional; also accepted as a TapData base-URL alias.
BANKING_API_BASE_URL=https://banking-api.example.invalid
# Data endpoint path. Required for the legacy api source; no default.
BANKING_DATA_PATH=/api/banking-data
# Optional authorization header name. Default: none.
BANKING_API_AUTH_HEADER=Authorization
# Optional authorization value; dummy only. Store real tokens in .env.
BANKING_API_AUTH_VALUE=Bearer replace-with-token
# Legacy fraud data path alias. Optional; default is empty.
FRAUD_DATA_PATH=/api/fraud-data

# Workflow persistence
# PostgreSQL URL. Optional; unset uses local JSON files under STATE_DIR.
DATABASE_URL=
# Verify PostgreSQL TLS certificates when true. Optional. Default: false.
PGSSL=false

# Authentication
# Set true only behind a trusted proxy that overwrites identity headers.
# Optional. Default: false. Do not enable for an unconfigured local demo.
TRUST_IDENTITY_PROXY=false

# Fraud review heuristics (potential indicators only, not proof of fraud)
# Rapid activity lookback minutes. Optional. Default: 5.
FRAUD_VELOCITY_WINDOW_MINUTES=5
# Transaction count in the rapid-activity window. Optional. Default: 5.
FRAUD_VELOCITY_TRANSACTION_COUNT=5
# Same-type amount compared with the account historical median. Optional. Default: 3.
FRAUD_AMOUNT_OUTLIER_MULTIPLIER=3
# Repeated failure/reversal lookback hours. Optional. Default: 24.
FRAUD_REPEATED_FAILURE_WINDOW_HOURS=24
# Failed/reversed record count needed for an indicator. Optional. Default: 3.
FRAUD_REPEATED_FAILURE_COUNT=3

# Centralized logging (readable timestamp-first output in console and files)
LOG_LEVEL=info
# LOG_FORMAT is a legacy setting; output is consistently human-readable.
LOG_DIR=./logs
LOG_RETENTION_DAYS=14
LOG_MAX_SIZE=10m
LOG_MAX_FILES=100
