# Application
HOST=0.0.0.0
PORT=3001
NODE_ENV=development
STATE_DIR=./var
DATA_SOURCE=tapdata

# AI provider
# Set AI_PROVIDER, AI_MODEL, and AI_BASE_URL to real values for your provider.
# Set DEEPSEEK_API_KEY or OPENAI_API_KEY to your real API key for the selected provider.
AI_PROVIDER=deepseek
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=sk-YOUR_DEEPSEEK_API_KEY
OPENAI_API_KEY=

# TapData API
# Set TAPDATA_API_BASE_URL to your real TapData API URL.
TAPDATA_API_BASE_URL=http://127.0.0.1:3080
TAPDATA_FIND_PATH_TEMPLATE=/api/v1/{collection}
TAPDATA_COLLECTION_MAP={"CUSTOMER":"MDM_CUSTOMER360"}
TAPDATA_FIND_METHOD=GET
TAPDATA_FIND_REQUEST_STYLE=query
TAPDATA_FIND_FILTER={}
TAPDATA_PAGE_SIZE=200
TAPDATA_SCAN_LIMIT=1000
TAPDATA_CACHE_TTL_MS=15000
TAPDATA_REQUEST_TIMEOUT_MS=15000

# TapData authentication
# Set TAPDATA_TOKEN_URL, TAPDATA_CLIENT_ID, and TAPDATA_CLIENT_SECRET to your real deployment values.
TAPDATA_TOKEN_URL=http://127.0.0.1:3030/oauth/token
TAPDATA_CLIENT_ID=YOUR_TAPDATA_CLIENT_ID
TAPDATA_CLIENT_SECRET=YOUR_TAPDATA_CLIENT_SECRET
TAPDATA_TOKEN_AUTH_METHOD=client_secret_post
TAPDATA_ACCESS_TOKEN=

# MongoDB
BANKING_MONGODB_URI=
BANKING_MONGODB_DATABASE=
BANKING_MONGODB_COLLECTION_MAP={}

# Legacy MongoDB aliases
MONGODB_URI=
MONGODB_DATABASE=
MONGODB_COLLECTION_MAP={}
MONGODB_READ_LIMIT=500

# Legacy banking API
BANKING_API_BASE_URL=
BANKING_DATA_PATH=
BANKING_API_AUTH_HEADER=
BANKING_API_AUTH_VALUE=
FRAUD_DATA_PATH=

# Workflow persistence
DATABASE_URL=
PGSSL=false

# Authentication
TRUST_IDENTITY_PROXY=false

# Fraud heuristics
FRAUD_VELOCITY_WINDOW_MINUTES=5
FRAUD_VELOCITY_TRANSACTION_COUNT=5
FRAUD_AMOUNT_OUTLIER_MULTIPLIER=3
FRAUD_REPEATED_FAILURE_WINDOW_HOURS=24
FRAUD_REPEATED_FAILURE_COUNT=3
